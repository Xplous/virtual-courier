FROM ghcr.io/ssskiv/virtual-courier-scene:latest

ENV DEBIAN_FRONTEND=noninteractive OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2

RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ros-humble-nav2-bringup ros-humble-nav2-mppi-controller \
      ros-humble-slam-toolbox ros-humble-cv-bridge ros-humble-tf2-geometry-msgs \
      ros-humble-tf2 ros-humble-tf2-ros ros-humble-tf2-py ros-humble-tf2-msgs \
      python3-opencv python3-numpy python3-colcon-common-extensions \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ros-humble-tf2)" ge 0.25.24 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /ros_ws
