diff --git a/explore/include/explore/goal_selection.h b/explore/include/explore/goal_selection.h
new file mode 100644
index 0000000..73660f1
--- /dev/null
+++ b/explore/include/explore/goal_selection.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <explore/frontier_search.h>
+#include <geometry_msgs/msg/pose.hpp>
+
+namespace explore
+{
+inline std::vector<frontier_exploration::Frontier>::iterator selectFrontier(
+  std::vector<frontier_exploration::Frontier>& frontiers,
+  const geometry_msgs::msg::Pose& pose,
+  const geometry_msgs::msg::Point* current_goal,
+  double orientation_scale, double switch_margin)
+{
+  const auto& q = pose.orientation;
+  const double yaw = std::atan2(2*(q.w*q.z+q.x*q.y), 1-2*(q.y*q.y+q.z*q.z));
+  for (auto& frontier : frontiers) {
+    const double bearing = std::atan2(frontier.centroid.y-pose.position.y,
+                                      frontier.centroid.x-pose.position.x);
+    frontier.cost += orientation_scale * std::abs(std::atan2(
+      std::sin(bearing-yaw), std::cos(bearing-yaw)));
+  }
+  std::stable_sort(frontiers.begin(), frontiers.end(),
+    [](const auto& a, const auto& b) { return a.cost < b.cost; });
+  if (frontiers.empty() || !current_goal) {
+    return frontiers.begin();
+  }
+  auto distance = [current_goal](const auto& f) {
+    return std::hypot(f.centroid.x-current_goal->x, f.centroid.y-current_goal->y);
+  };
+  auto current = std::min_element(frontiers.begin(), frontiers.end(),
+    [&distance](const auto& a, const auto& b) { return distance(a) < distance(b); });
+  if (distance(*current) < 0.75 && current->cost <= frontiers.front().cost+switch_margin) {
+    return current;
+  }
+  return frontiers.begin();
+}
+}  // namespace explore
