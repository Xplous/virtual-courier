+static frontier_exploration::Frontier candidate(double x, double y, double cost)
+{
+  frontier_exploration::Frontier f{};
+  f.centroid.x = x;
+  f.centroid.y = y;
+  f.cost = cost;
+  return f;
+}
+
+TEST(ExploreSelection, PrefersForwardOverSlightlyBetterRearGoal)
+{
+  geometry_msgs::msg::Pose pose;
+  pose.orientation.w = 1.0;
+  std::vector<frontier_exploration::Frontier> goals{candidate(-2, 0, -2), candidate(2, 0, -1)};
+  EXPECT_GT(explore::selectFrontier(goals, pose, nullptr, 2, 1)->centroid.x, 0);
+  pose.orientation.w = 0.0;
+  pose.orientation.z = 1.0;
+  goals = {candidate(-2, 0, -2), candidate(2, 0, -1)};
+  EXPECT_LT(explore::selectFrontier(goals, pose, nullptr, 2, 1)->centroid.x, 0);
+}
+
+TEST(ExploreSelection, KeepsCurrentFrontierDespiteSmallCentroidAndCostChanges)
+{
+  geometry_msgs::msg::Pose pose;
+  pose.orientation.w = 1.0;
+  geometry_msgs::msg::Point current;
+  current.x = 2;
+  std::vector<frontier_exploration::Frontier> goals{candidate(2.1, 0, -1), candidate(0, 2, -1.5)};
+  EXPECT_GT(explore::selectFrontier(goals, pose, &current, 0, 1)->centroid.x, 0);
+}
+
+TEST(ExploreSelection, SwitchesForSignificantImprovement)
+{
+  geometry_msgs::msg::Pose pose;
+  pose.orientation.w = 1.0;
+  geometry_msgs::msg::Point current;
+  current.x = 2;
+  std::vector<frontier_exploration::Frontier> goals{candidate(2, 0, -1), candidate(0, 2, -3)};
+  EXPECT_GT(explore::selectFrontier(goals, pose, &current, 0, 1)->centroid.y, 0);
+}
+
+TEST(ExploreSelection, ReleasesDisappearedCurrentFrontier)
+{
+  geometry_msgs::msg::Pose pose;
+  pose.orientation.w = 1.0;
+  geometry_msgs::msg::Point current;
+  current.x = 2;
+  std::vector<frontier_exploration::Frontier> goals{candidate(0, 2, -1)};
+  EXPECT_GT(explore::selectFrontier(goals, pose, &current, 2, 1)->centroid.y, 0);
+}
+
+TEST(ExploreSelection, AllowsNecessaryTurnAround)
+{
+  geometry_msgs::msg::Pose pose;
+  pose.orientation.w = 1.0;
+  std::vector<frontier_exploration::Frontier> goals{candidate(-2, 0, -1)};
+  EXPECT_LT(explore::selectFrontier(goals, pose, nullptr, 2, 1)->centroid.x, 0);
+  goals.clear();
+  EXPECT_EQ(explore::selectFrontier(goals, pose, nullptr, 2, 1), goals.end());
+}
